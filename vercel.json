{
    "version": 2,
    "builds": [
        {
            "src": "Backend/Server/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "Frontend/package.json",
            "use": "@vercel/static-build",
            "config": { "distDir": "dist" }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/Backend/Server/server.js"
        },
        {
            "src": "/(.*)",
            "dest": "/Frontend/$1"
        }
    ]
}
